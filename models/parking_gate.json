          },
          {
            "name": "BarrierDown",
            "params": []
          }
        ],
        "transitions": [
          {
            "source": "Closed",
            "event": "VehicleDetected",
            "target": "Opening"
          },
          {
            "source": "Opening",
            "event": "BarrierUp",
            "target": "Open"
          },
          {
            "source": "Open",
            "event": "VehicleCleared",
