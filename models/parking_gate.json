  "scenario": [
    "create object instance lot of LOT;",
    "lot.name = \"Central Parking\";",
    "lot.capacity = 50;",
    "create object instance slot1 of SLOT;",
    "slot1.number = 1;",
    "slot1.status = SlotStatus::FREE;",
    "relate lot to slot1 across R1;",
    "create object instance entry of ENTRY;",
    "entry.gateId = \"GATE-IN-1\";",
    "entry.isOpen = false;",
    "relate lot to entry across R2;",
    "create object instance exitGate of EXIT;",
    "exitGate.gateId = \"GATE-OUT-1\";",
    "exitGate.isOpen = false;",
    "relate lot to exitGate across R2;",
    "create object instance car of VEH;",
    "car.plateNumber = \"AB 1234 XY\";",
    "car.type = VehicleType::CAR;",
    "entry.handleVehicle(veh: car);"
  ]
