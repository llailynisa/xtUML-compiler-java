    {
      "name": "EntryGate",
      "key_letters": "ENTRY",
      "is_abstract": false,
      "attributes": [],
      "operations": [
        {
          "name": "handleVehicle",
          "params": [
            {
              "name": "veh",
              "type": "inst_ref:VEH"
            }
          ],
          "return_type": "void",
          "is_abstract": false,
          "body": [
            "select any slot from instances of SLOT where (selected.status == SlotStatus::FREE);",
            "if (not_empty slot)",
            "  slot.status = SlotStatus::OCCUPIED;",
            "  create object instance session of SESS;",
            "  session.sessionId = \"SESS-001\";",
            "  session.isPaid = false;",
            "  relate veh to slot across R4 using session;",
            "  generate Gate:VehicleDetected() to self;",
            "end if;"
          ]
        }
      ]
    },
    {
      "name": "ExitGate",
      "key_letters": "EXIT",
      "is_abstract": false,
      "attributes": [],
      "operations": [
        {
          "name": "handleVehicle",
          "params": [
            {
              "name": "veh",
              "type": "inst_ref:VEH"
            }
          ],
          "return_type": "void",
          "is_abstract": false,
          "body": [
            "select one session related by veh->R4[ParkingSession];",
            "if (not_empty session)",
            "  if (session.isPaid == true)",
            "    select one slot related by veh->R4[ParkingSlot];",
            "    if (not_empty slot)",
            "      slot.status = SlotStatus::FREE;",
            "    end if;",
            "    generate ParkingSession:Exited() to session;",
            "    generate Gate:VehicleDetected() to self;",
            "  end if;",
            "end if;"
          ]
        }
      ]
    },
