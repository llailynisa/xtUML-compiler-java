      "state_machine": {
        "initial": "Closed",
        "states": [
          {
            "name": "Closed",
            "action": [
              "self.isOpen = false;"
            ]
          },
          {
            "name": "Opening",
            "action": [
              "generate Gate:BarrierUp() to self;"
            ]
          },
          {
            "name": "Open",
            "action": [
              "self.isOpen = true;"
            ]
          },
          {
            "name": "Closing",
            "action": [
